{
  "name": "extremis",
  "version": "0.4.0",
  "description": "Portable capability layer for AI agents: 70 Agent Skills and workflows, 10 specialist agents and 45 tools you can discover, activate, run and verify over MCP, CLI or SDK, plus a finder for public skills.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "FAHTHIZ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FAHTHIZ/EXTREMIS.git"
  },
  "engines": {
    "node": ">=18.17"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "extremis": "bin/extremis.mjs"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "capabilities",
    "registry",
    "agents",
    "skills",
    "hooks",
    ".claude-plugin",
    ".codex-plugin",
    ".mcp.json",
    "LICENSE",
    "README.md",
    "evals"
  ],
  "scripts": {
    "test": "node --test",
    "validate": "node bin/extremis.mjs validate",
    "eval": "node bin/extremis.mjs eval"
  },
  "keywords": [
    "agent-skills",
    "mcp",
    "ai-agents",
    "claude-code",
    "skills",
    "tools",
    "capabilities",
    "oasis",
    "skill-finder",
    "skills-sh",
    "skill-search",
    "model-context-protocol",
    "codex",
    "cursor",
    "claude-skills",
    "agent-skills-discovery",
    "ai-tools",
    "llm",
    "subagents",
    "prompt-engineering",
    "llm-evaluation",
    "claude-code-subagents"
  ]
}
