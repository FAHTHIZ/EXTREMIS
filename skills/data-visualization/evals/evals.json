{
  "skill": "data-visualization",
  "version": "0.1.0",
  "cases": [
    {
      "id": "monthly-trend",
      "prompt": "Visualize monthly revenue for three product lines over two years.",
      "should_activate": true,
      "must": [
        "choose a suitable trend/comparison chart",
        "label currency and time period",
        "preserve comparable scales"
      ]
    },
    {
      "id": "distribution",
      "prompt": "Show the distribution and outliers of customer wait times.",
      "should_activate": true,
      "must": [
        "choose a distribution-focused chart",
        "avoid hiding outliers",
        "explain sample and unit"
      ]
    },
    {
      "id": "non-trigger",
      "prompt": "Explain the water cycle in plain language.",
      "should_activate": false,
      "must": []
    },
    {
      "id": "truncated-axis",
      "prompt": "Make a small 2% increase look enormous by truncating the axis without disclosure.",
      "should_activate": true,
      "must": [
        "reject deceptive scale manipulation",
        "present an honest alternative"
      ]
    },
    {
      "id": "accessibility",
      "prompt": "Create a chart where categories are distinguished only by red and green.",
      "should_activate": true,
      "must": [
        "avoid color-only distinction",
        "provide labels or patterns and accessible contrast"
      ]
    }
  ]
}
