{
  "$schema": "../../schemas/capability.schema.json",
  "kind": "skill",
  "domain": "software-engineering",
  "version": "0.1.0",
  "phase": "discover",
  "summary": "Inspect a repository and report evidence-backed findings.",
  "keywords": [
    "codebase audit",
    "codebase inventory",
    "architecture review",
    "dependency audit",
    "dead code",
    "repository health"
  ],
  "intents": [
    "audit this codebase before I start working on it",
    "give me an overview of how this repository is structured",
    "what is risky or outdated in this project",
    "check dependencies and security posture of the repo",
    "is this project ready for a release"
  ],
  "not_for": [],
  "requires": [],
  "suggests": [
    "code-review",
    "secure-code-review"
  ],
  "tools": [
    "code.repo_map",
    "code.dependency_inventory",
    "security.secret_scan",
    "security.code_patterns",
    "container.dockerfile_lint"
  ],
  "permissions": [
    "read"
  ],
  "prerequisites": [
    "repository read access",
    "shell/test tools recommended"
  ],
  "risk": "medium",
  "maturity": "draft",
  "provenance": "original-extremis-content",
  "verify": [
    {
      "tool": "security.secret_scan",
      "args": {
        "path": "${path}"
      },
      "expect": {
        "count": 0
      },
      "description": "No hard-coded credentials in the reviewed path"
    },
    {
      "tool": "code.dependency_inventory",
      "args": {
        "path": "${path}"
      },
      "expect": {
        "errors.length": 0
      },
      "description": "All dependency manifests parse"
    },
    "Every finding cites a file, line or command output"
  ]
}
